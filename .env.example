DATABASE_URL=postgres://turnly:turnly@localhost:5432/turnly
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:8080
ADMIN_TOKEN=change-me

# Meta WhatsApp Cloud API (leave token empty or set WA_MODE=mock to run without sending)
WA_MODE=mock
META_APP_ID=
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_SYSTEM_USER_TOKEN=
WABA_ID=
PHONE_NUMBER_ID=TEST_PNID
OPERATOR_ALERT_PHONE=+919000000001

# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=

# Conversions API + Pixel (optional until ads go live)
META_PIXEL_ID=
META_CAPI_TOKEN=
SENTRY_DSN=

# Live Google Sheet sync (optional). Service account JSON (raw or base64), the sheet's ID, and the tab name.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# Twilio WhatsApp (alternative to Meta). With these set, Twilio is used. TRUST_TEMPLATES=1 is for the sandbox only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TRUST_TEMPLATES=

# Email alerts through Resend (resend.com). Free plan; the default sender can only email the account owner's own address.
RESEND_API_KEY=
ALERT_EMAIL=
EMAIL_FROM=

# Calendly event link. When set, the thank-you screen offers 'Pick a time for your call'.
CALENDLY_URL=

# Calendly personal access token. With it, bookings are matched to leads and you are emailed when a call is booked, moved or canceled.
CALENDLY_TOKEN=

# The WhatsApp number the website's 'Chat on WhatsApp' buttons open (international format, e.g. +91 90531 51756). Hidden when empty.
WHATSAPP_NUMBER=
